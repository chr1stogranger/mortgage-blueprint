# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Secrets — never commit env files (re-audit L-2). .env.example is allowed.
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
dist-test/
dist-build
# any other stray local build/verify output (dist-check2, dist-verify3, ...)
dist-*

# sed -i.bak leftovers (sandbox can't delete)
*.bak

# FUSE-mount artifacts from sandbox sessions — never commit these
.fuse_hidden*

# Agent scratch worktrees — never commit
.claude/worktrees/
